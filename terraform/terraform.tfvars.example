# Account & region
aws_region     = "us-east-1"
aws_profile    = "your-aws-profile"
aws_account_id = "123456789012"
# project_name namespaces every resource this stack creates. Pick a distinct value if another
# deployment already exists in the same account/region — there's no shared backend to prevent collisions.
project_name = "benchmarkcat"

# IAM roles (existing — not managed by Terraform)
batch_job_role_arn     = "arn:aws:iam::123456789012:role/Batch-Job-Role"
batch_instance_profile = "arn:aws:iam::123456789012:instance-profile/Batch-Instance-Role"
spot_fleet_role_arn    = "arn:aws:iam::123456789012:role/AmazonEC2SpotFleetRole"
batch_service_role_arn = "arn:aws:iam::123456789012:role/aws-service-role/batch.amazonaws.com/AWSServiceRoleForBatch"

# Networking
subnets = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy",
]
security_group_ids = [
  "sg-xxxxxxxxxxxxxxxxx",
]

# Compute
max_vcpus      = 256
instance_types = ["m5.xlarge", "m5.2xlarge", "r5.xlarge", "r5.2xlarge"]
use_spot       = false  # set true for Spot
ecr_force_delete = false  # set true for dev

# Docker image tag (pin to a specific SHA or semver in production)
image_tag = "latest"

# CloudWatch log retention (days)
log_retention_days = 365

# S3 bucket
s3_bucket      = "your-s3-bucket"
scenes_per_job = 50

# --- paths ---

# Shared paths (HUC8 + country boundaries are the same)
catalog_path          = "stac/"
hucs_object_key       = "benchmark/stac-bench-cat/assets/WBDHU8_webproj.gpkg"
boundaries_object_key = "benchmark/stac-bench-cat/assets/Mexico_Canada_boundaries.gpkg"
gfm_readme_object_key = "benchmark/stac-bench-cat/assets/gfm_data_readme.pdf"

# GFM paths
gfm_asset_object_key          = "data-gfm/"
gfm_manifest_s3_key           = "stac/batch/gfm_manifest.jsonl"
gfm_partial_parquet_prefix    = "stac/batch/gfm_partials"
gfm_derived_metadata_path     = "stac/assets/gfm_collection.parquet"
gfm_dfo_geopackage_object_key = "benchmark/rs/dfo_all_usa_events_post_2015.gpkg"

# GFM_EXP paths
gfm_exp_asset_object_key       = "data-gfm-exp/"
gfm_exp_manifest_s3_key        = "stac/batch/gfm_exp_manifest.jsonl"
gfm_exp_partial_parquet_prefix = "stac/batch/gfm_exp_partials"
gfm_exp_derived_metadata_path  = "stac/assets/gfm_expanded_collection.parquet"

# Ripple paths (flows2fim extent generation — STAC cataloging is separate)
ripple_asset_object_key      = "ripple/v0.11.x/successes/"
ripple_manifest_s3_key       = "benchmark/ripple_v0.11.x/batch/ripple_manifest.jsonl"
ripple_success_markers_prefix = "benchmark/ripple_v0.11.x/status/success/"
ripple_error_retry_prefix     = "benchmark/ripple_v0.11.x/status/errors/retry/"
ripple_error_nonretry_prefix  = "benchmark/ripple_v0.11.x/status/errors/nonretry/"
ripple_items_per_job          = 5
